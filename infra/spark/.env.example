# This file is optional. Copy it to infra/spark/.env and pass it with
# --env-file infra/spark/.env when you need to override the local defaults.
SPARK_VERSION=3.5.6
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.6
KAFKA_BOOTSTRAP_SERVERS=kafka:19092
ACTIVITY_EVENTS_TOPIC=activity-events
KAFKA_CLUSTER_ID=local
RAW_EVENTS_PATH=/opt/project/data/raw_events
RAW_EVENTS_CHECKPOINT_PATH=/opt/project/data/checkpoints/raw-events
RAW_EVENTS_STARTING_OFFSETS=earliest
RAW_EVENTS_TRIGGER_INTERVAL=10 seconds

# Commons Mart 가명(brand_hash) 소금값. 실행마다 같아야 코호트가 흔들리지 않는다.
# 저장소에 진짜 값을 두지 않는다 — 이 파일은 예시고 .env 는 gitignore 된다.
# 비어 있으면 derive_facts_job 이 시작 단계에서 실패한다 (dw-schema §2.5.1 R5).
COMMONS_HASH_SALT=change-me-local-dev-only
