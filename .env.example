# LLM 에이전트 러너(simulator/agents/agent_runner.py)가 읽는 키.
# 이 파일을 .env 로 복사하고 값을 채우십시오. .env 는 .gitignore 에 있어 커밋되지 않습니다.
#
#   cp .env.example .env
#
# 환경변수가 이미 있으면 그쪽이 우선입니다.

# SSAFY GMS 게이트웨이 (기본 경로)
# 이 키는 shop-backend가 아니라 추천 서버(recommend) 컨테이너가 사용합니다.
# shop-backend는 RECOMMEND_URL로 추천 서버의 분류 API만 호출합니다.
GMS_KEY=

# 고객 피드백 분류 배치: 매일 한국시간 06:00, 회차당 최대 200건
SHOP_FEEDBACK_CLASSIFY_CRON=0 0 6 * * *
SHOP_FEEDBACK_CLASSIFY_BATCH_SIZE=200
RECOMMEND_FEEDBACK_TIMEOUT_MS=30000

# 개인 OpenAI 키를 쓸 때만 (--openai)
OPENAI_API_KEY=

# shop_backend 전용. 포트원 콘솔 > 결제 연동 > V2 API Secret에서 발급합니다.
# 브라우저 번들에 들어가는 VITE_PORTONE_* 값과 달리 외부에 노출하면 안 됩니다.
PORTONE_API_SECRET=
PORTONE_API_URL=https://api.portone.io
PORTONE_TIMEOUT_MS=10000
