# 프론트 환경변수 예시. 실제 값은 .env.local (gitignore) 또는 배포 빌드의 .env.production 에.
# 전부 빌드 시점 값이다 (Vite). nginx 이미지 빌드 전에 있어야 한다.

# 시연 신규 예외 접두 (Jira 247-b). 추천 서버 NEW_BRAND_ALWAYS_PREFIX 와 같은 값
VITE_NEW_BRAND_ALWAYS_PREFIX=SB

# 포트원 V2 · 카카오페이 테스트 채널 (src/lib/payment.ts). 둘 다 있어야 결제창이 열리고, 없으면 테스트 주문.
# 관리자콘솔 > 결제 연동 > 채널관리 > 채널 추가(카카오페이 · 테스트 모드 · CID TC0ONETIME) 에서 받는 공개 값.
# API Secret 은 서버(shop_backend PORTONE_API_SECRET) 전용 — 여기 넣지 않는다.
VITE_PORTONE_STORE_ID=
VITE_PORTONE_CHANNEL_KEY=
