KAFKA_BOOTSTRAP_SERVERS=REPLACE_WITH_EC2_2_PRIVATE_IP:9092
ACTIVITY_EVENTS_TOPIC=activity-events
ACTIVITY_EVENTS_PARTITIONS=3

# Shop Backend / MySQL
SHOP_BACKEND_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SHOP_BACKEND_JWT_EXPIRATION_MS=900000
MYSQL_DATABASE=shop_backend
MYSQL_USER=shop_backend
MYSQL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_ROOT_PASSWORD
DEPLOYMENT_ENVIRONMENT=ec2
ALLOWED_ORIGINS=https://j15a306.p.ssafy.io

# PortOne V2. VITE_* values are embedded in the browser bundle at nginx build
# time; PORTONE_API_SECRET is injected into shop-backend only.
VITE_PORTONE_STORE_ID=
VITE_PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# 추천 서버 (AI). compose 안 서비스 이름으로 붙는다 — 보통 바꿀 일 없음
RECOMMEND_URL=http://recommend:8300
# 처방 문장 생성용 LLM 키 (GMS). 비우면 추천은 되고 /api/prescription 만 503
GMS_KEY=
# 쇼핑몰 백엔드(8090) 주소 — 추천 서버가 ACTIVE 상품을 주기적으로 읽어 카탈로그에 맞춘다 (Jira 222). 비우면 동기화 안 함
SHOP_BACKEND_URL=
CATALOG_SYNC_INTERVAL_SEC=300
# 신규 브랜드 = 등록 후 N일 (Jira 247-b). SSAFY Beauty(product_id SB*) 는 기간 무관 신규 — 시연 결정 2026-09-14 (Jira 249)
NEW_BRAND_DAYS=14
NEW_BRAND_ALWAYS_PREFIX=SB

CERTBOT_WEBROOT_PATH=/opt/hwabun/certbot/www
LETSENCRYPT_PATH=/etc/letsencrypt
