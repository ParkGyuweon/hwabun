# Required: EC2-2 IP/DNS reachable FROM EC2-1 (no scheme or port).
# Prefer a private address when both hosts have private network connectivity.
KAFKA_ADVERTISED_HOST=
KAFKA_BIND_IP=0.0.0.0
ACTIVITY_EVENTS_TOPIC=activity-events
ACTIVITY_EVENTS_PARTITIONS=3
KAFKA_TOPIC_RETENTION_MS=86400000
KAFKA_HEAP_OPTS="-Xms512m -Xmx1g"

# Keep these stable when reusing Kafka data / Spark checkpoints.
KAFKA_KRAFT_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_DATA_VOLUME=hwabun-ec2-2-kafka-data
KAFKA_SOURCE_CLUSTER_ID=ec2-2
SPARK_DATA_PATH=/opt/hwabun/data

# Q1 uses one core; leave at least one more core and 1g for batch jobs.
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
RAW_EVENTS_STARTING_OFFSETS=earliest
RAW_EVENTS_TRIGGER_INTERVAL="10 seconds"

# Optional, used only by `docker compose --profile dw run --rm dw-projection`.
# EC2-1 MySQL host address; NOT localhost or its Docker service name.
DW_MYSQL_HOST=
DW_MYSQL_PORT=13306
DW_MYSQL_DB=dw
DW_MYSQL_USER=dw_writer
DW_MYSQL_PASSWORD=
