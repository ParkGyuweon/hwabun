[Unit]
Description=HWABUN daily Spark mart batch and DW projection
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
# Non-zero exit (Q2~Q4 abort, Q5 or DW publish failure) -> post to the webhook in
# /etc/hwabun/alert.env. No URL configured -> the notifier only logs.
OnFailure=hwabun-batch-notify@%n.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/ubuntu/S15P21A306/deploy/ec2-2
Environment=HWABUN_REPO_ROOT=/home/ubuntu/S15P21A306
ExecStart=/usr/bin/bash /home/ubuntu/S15P21A306/deploy/ec2-2/run-daily-batch.sh
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
