        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "sum(increase(collector_events_validation_failures_total{application=\"log-connector\"}[5m]))",
          "legendFormat": "last 5m",
          "refId": "A"
        }
      ],
      "title": "Validation failures (5m)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "min": 0, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(collector_events_validation_failures_total{application=\"log-connector\"}[1m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "title": "Validation failures by reason",
